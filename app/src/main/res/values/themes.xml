<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.McMonitor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/grass</item>
        <item name="colorOnPrimary">#06120B</item>
        <item name="colorPrimaryContainer">@color/grass_dark</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/dirt</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg</item>

        <!-- Stile a blocchi applicato una volta sola, dal tema: niente angoli
             arrotondati, pulsanti in pietra con testo scuro, sfondo a mattoni. -->
        <item name="android:windowBackground">@drawable/bg_window_stone</item>
        <item name="materialButtonStyle">@style/McButton</item>
        <item name="materialButtonOutlinedStyle">@style/McButton.Outlined</item>
        <item name="materialCardViewStyle">@style/McCard</item>
        <item name="shapeAppearanceSmallComponent">@style/McShape</item>
        <item name="shapeAppearanceMediumComponent">@style/McShape</item>
        <item name="shapeAppearanceLargeComponent">@style/McShape</item>
    </style>

    <!-- Angoli vivi: è ciò che rende "a blocchi" l'interfaccia. -->
    <style name="McShape" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/grass</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textIsSelectable">true</item>
    </style>

</resources>
