<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Squadrati come i blocchi: nessun angolo arrotondato in tutta l app. -->
    <style name="McButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/stone</item>
        <item name="android:textColor">@color/stone_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Azione principale: verde erba, sempre con testo scuro sopra. -->
    <style name="McButton.Primary">
        <item name="backgroundTint">@color/grass</item>
        <item name="android:textColor">#06120B</item>
    </style>

    <style name="McButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/stone_edge</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/grass</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="McButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">0dp</item>
        <item name="android:textColor">@color/grass</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Pannello incassato: e il contenitore di ogni scheda. -->
    <style name="McCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stone_edge</item>
        <item name="strokeWidth">2dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Anche la voce selezionata del menu e squadrata, e le icone a pixel
         restano dei loro colori invece di diventare una macchia verde. -->
    <style name="McNavItem">
        <item name="cornerSize">0dp</item>
    </style>
</resources>
