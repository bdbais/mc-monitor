<?xml version="1.0" encoding="utf-8"?>
<!-- Pannello incassato: cornice chiara di pietra e fondo scuro, come le targhe
     dell'interfaccia di gioco. Gli spessori sono asimmetrici per dare rilievo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#9A9A9A" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:end="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#C4C4C4" />
        </shape>
    </item>

    <item
        android:start="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#5C5C5C" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:end="3dp"
        android:start="3dp"
        android:top="3dp">
        <bitmap
            android:src="@drawable/tile_dark"
            android:tileModeX="repeat"
            android:tileModeY="repeat" />
    </item>
</layer-list>
