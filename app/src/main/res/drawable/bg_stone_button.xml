<?xml version="1.0" encoding="utf-8"?>
<!-- Bottone in pietra: bordo chiaro in alto a sinistra, scuro in basso a destra.
     Premuto, il rilievo si inverte: è il modo in cui il gioco mostra il click. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#5C5C5C" />
                </shape>
            </item>
            <item android:top="2dp" android:start="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8A8A8A" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#C4C4C4" />
                </shape>
            </item>
            <item android:bottom="2dp" android:end="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#9A9A9A" />
                </shape>
            </item>
            <item android:top="2dp" android:start="2dp" android:bottom="3dp" android:end="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8A8A8A" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
