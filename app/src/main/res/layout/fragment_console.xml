<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Senza RCON i comandi partono e basta: il server non risponde e qui non si
         vede se hanno fatto qualcosa. Va detto dove si guarda, non nascosto. -->
    <LinearLayout
        android:id="@+id/avvisoRcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_inset"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/avvisoRconTitolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/warning"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="RCON non è attivo" />

        <TextView
            android:id="@+id/avvisoRconTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            tools:text="I comandi partono, ma il server non ha modo di rispondere." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAvvisoDopo"
                style="@style/McButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Non ora" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAvvisoRcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Attiva RCON" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rigaControlli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoRefresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Aggiornamento automatico" />

        <!-- Le file di comandi già pronte: qui, accanto alla console, che è dove
             i comandi si scrivono uno per volta. -->
        <ImageButton
            android:id="@+id/btnMacro"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Macro: file di comandi già pronte"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_macro"
            android:tooltipText="Macro" />

        <ImageButton
            android:id="@+id/btnCerca"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Cerca nel log"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search"
            android:tooltipText="Cerca" />

        <ImageButton
            android:id="@+id/btnWrap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Manda a capo le righe lunghe"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wrap"
            android:tooltipText="A capo automatico" />

        <ImageButton
            android:id="@+id/btnFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Mostra solo il log, a tutto schermo"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fullscreen"
            android:tooltipText="Tutto schermo" />
    </LinearLayout>

    <!-- Compare solo con la ricerca accesa: il log resta il protagonista. -->
    <LinearLayout
        android:id="@+id/rigaFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="cerca nel log (es. un nome)"
            app:boxBackgroundColor="@color/surface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/filtro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/esitoFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Il log e il pulsante per uscire dal tutto schermo, sovrapposto in alto a
         destra: in quella modalita' e' l'unico comando che resta a schermo. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                android:padding="10dp">

                <HorizontalScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/log"
                        style="@style/Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true" />
                </HorizontalScrollView>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ImageButton
            android:id="@+id/btnEsciSchermo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:alpha="0.85"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Torna alla scheda"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fullscreen_exit"
            android:visibility="gone" />
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/rigaComandi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quickCommands"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="0dp"
            app:singleLine="true" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/rigaInvio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="comando console (es. say ciao)"
            app:boxBackgroundColor="@color/surface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- In orizzontale la fila di scorciatoie sparisce per far posto al log:
             i comandi restano raggiungibili da qui, in elenco. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComandi"
            style="@style/McButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="Comandi"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/McButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Invia" />
    </LinearLayout>
</LinearLayout>
