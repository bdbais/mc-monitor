<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/press_start_2p"
            android:textColor="@color/grass"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:background="@color/surface_high" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMap"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mostra sulla mappa e segui" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChat"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cronologia chat e comandi" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPosta"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Lascia un messaggio" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTeleport"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Teletrasporta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGamemode"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Modalità di gioco" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpawnpoint"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Imposta qui il suo punto di rinascita" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Permessi" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhitelistAdd"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="+ Whitelist" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhitelistRemove"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="− Whitelist" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOp"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Op" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeop"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deop" />
        </LinearLayout>

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Moderazione" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKick"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Espelli" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBan"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Banna" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPardon"
            style="@style/McButton.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rimuovi il ban" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
