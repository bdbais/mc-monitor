<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passo 1 · come lo chiami" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="Il nome serve solo a te, per ritrovarlo nell'elenco. Il nome tecnico dà il nome alla sua cartella sul computer."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome (come lo vedi nell'elenco)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome tecnico (sottocartella nella home)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/slug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Passo 2 · come entrare nel computer" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="Sono gli stessi dati del collegamento. Cambiarli qui vale solo per questo server."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host o IP">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.35"
                android:hint="Porta">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="0.65"
                android:hint="Utente SSH">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password (vuota se usi la chiave)"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            style="@style/McButton.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cambia la password dell'utente SSH" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chiave privata OpenSSH (incolla il file intero)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/privateKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="3"
                android:textSize="11sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Passphrase della chiave (se presente)"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passphrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Passo 3 · dove sta il server" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="Cartella dell'istanza e nome dello script. Se il server l'hai scelto dall'elenco, sono già compilati: non toccarli."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Directory LinuxGSM (es. /home/mcserver)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lgsmDir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Script LinuxGSM (es. mcserver)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="serverfiles (vuoto = &lt;dir&gt;/serverfiles)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sessione tmux (vuoto = nome dello script)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tmuxSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/useLgsmSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="Invia comandi con &quot;lgsm send&quot; (altrimenti tmux)" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Passo 4 · privacy e copie di sicurezza" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/privacyMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Modalità privacy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nasconde a schermo indirizzo del server, nomi dei giocatori e password: puoi fare uno screenshot e mandarlo senza pensieri. Copia e Condividi usano comunque il valore vero."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Esporta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImport"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Importa" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/backupEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Backup automatico cifrato" />

        <TextView
            android:id="@+id/backupFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nessuna cartella scelta"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackupFolder"
                style="@style/McButton.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scegli cartella" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackupNow"
                style="@style/McButton.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Backup ora" />
        </LinearLayout>

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Passo 5 · quando avvisarti" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="L'app controlla il server a intervalli e avvisa quando succede qualcosa. Resta una notifica fissa mentre il monitoraggio è attivo: Android la richiede per il lavoro in background, e consuma batteria."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notifyEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitora questo server" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notifyOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:checked="true"
            android:text="Server offline o irraggiungibile" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notifyOnline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:checked="true"
            android:text="Server tornato online" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notifyJoin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:checked="true"
            android:text="Un giocatore entra" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notifyLeave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Un giocatore esce" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ogni quanti secondi controllare (minimo 30)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/notifySeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Passo 6 · comandi diretti (RCON)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Con RCON i comandi tornano la risposta del server e non lasciano righe di servizio nel log. Il tunnel SSH lo rende raggiungibile senza aprire porte sul firewall."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/rconEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usa RCON per comandi e posizioni" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/rconTunnel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="Passa dal tunnel SSH (consigliato)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.4"
                android:hint="Porta RCON">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rconPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:hint="Password RCON"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rconPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRconPassword"
                style="@style/McButton.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Genera password" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRconTest"
                style="@style/McButton.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prova RCON" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRconSetup"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attiva RCON sul server e riavvia" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Passo 7 · la mappa del mondo" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="Se sul server gira Dynmap, BlueMap o squaremap, l'indirizzo va qui e la mappa si apre dall'app."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL mappa web Dynmap/BlueMap (opzionale)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/webMapUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Intervallo tracciamento posizioni (secondi)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pollSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Salva" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prova connessione" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrepare"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Prepara un server vuoto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnose"
            style="@style/McButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Diagnostica connessione" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForgetHostKey"
            style="@style/McButton.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dimentica fingerprint host" />

        <TextView
            android:id="@+id/testResult"
            style="@style/Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Le credenziali restano nella memoria privata dell'app su questo dispositivo. Per sicurezza usa un utente SSH dedicato con accesso a chiave."
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
