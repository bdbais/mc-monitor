<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_appbar_stone">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_inset"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/press_start_2p"
                    android:text="@string/app_name"
                    android:textColor="@color/grass"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnInfo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_stone_button"
                    android:contentDescription="Informazioni sull'applicazione"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info"
                    android:tint="#22262A"
                    android:tooltipText="Informazioni" />

                <ImageButton
                    android:id="@+id/btnHelp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_stone_button"
                    android:contentDescription="Aiuto su questa pagina"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_help"
                    android:tint="#22262A"
                    android:tooltipText="Aiuto" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/updateBanner"
        layout="@layout/view_update_banner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="I tuoi server. Tocca per selezionare, poi Apri."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnSortCreated"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Ordina per data di creazione"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_clock_mc"
            android:tooltipText="Per creazione" />

        <ImageButton
            android:id="@+id/btnSortUsed"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Ordina per ultimo utilizzo"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_compass_mc"
            android:tooltipText="Usati di recente" />

        <ImageButton
            android:id="@+id/btnManual"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_stone_button"
            android:contentDescription="Manuale d'uso"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_book"
            android:tooltipText="Manuale d'uso" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="Nessun server configurato.\nPremi Aggiungi per crearne uno."
        android:textAlignment="center"
        android:textColor="@color/text_dim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Aggiungi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modifica" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClone"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Duplica" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemove"
                style="@style/McButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rimuovi" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            style="@style/McButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apri" />
    </LinearLayout>
</LinearLayout>
