<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contenitore"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_appbar_stone">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_stone_button"
                    android:contentDescription="Apri il menu"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:background="@drawable/bg_panel_inset"
                    android:baselineAligned="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/press_start_2p"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textColor="@color/grass"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            <ImageButton
                    android:id="@+id/btnTrovato"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_red_button"
                    android:contentDescription="Minestrat"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_piccone_mc"
                    android:visibility="gone" />

            <ImageButton
                    android:id="@+id/btnImpostazioni"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_stone_button"
                    android:contentDescription="Impostazioni"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gear_mc"
                    android:tooltipText="Impostazioni" />
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <include
            android:id="@+id/updateBanner"
            layout="@layout/view_update_banner" />

        <FrameLayout
            android:id="@+id/contenuto"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        app:headerLayout="@layout/nav_header"
        app:itemIconSize="26dp"
        app:itemIconTint="@null"
        app:itemShapeAppearanceOverlay="@style/McNavItem"
        app:itemShapeFillColor="@color/nav_item_fill"
        app:itemTextColor="@color/nav_item_text"
        app:menu="@menu/menu_home" />

</androidx.drawerlayout.widget.DrawerLayout>
