<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Serve solo per proporre l'aggiornamento dell'app stessa: l'installazione
         la conferma comunque l'utente nella schermata di sistema. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Notifiche sugli eventi del server: il monitoraggio è opt-in e usa un
         servizio in primo piano, perché Android non consente polling ravvicinato
         in background e il server non può inviare push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.McMonitor">

        <!-- La porta: nome dell'amministratore al primo avvio, password dopo. -->
        <activity
            android:name=".ui.LockActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- I due passi con il menu a sinistra: è da qui che si entra. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".ui.LockActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- L'elenco dei profili salvati resta per chi ne gestisce parecchi. -->
        <activity
            android:name=".ui.ServersActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".ui.HomeActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".ui.HomeActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Chi altro sta amministrando questo server, e i messaggi fra loro. -->
        <activity
            android:name=".ui.AdminActivity"
            android:exported="false"
            android:label="Amministratori"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Perche' il server non e' partito: i log, letti e spiegati. -->
        <activity
            android:name=".ui.AvvioActivity"
            android:exported="false"
            android:label="Avvio"
            android:parentActivityName=".MainActivity" />

        <!-- Quanto e' chiuso il server. -->
        <activity
            android:name=".ui.SecurityActivity"
            android:exported="false"
            android:label="Sicurezza"
            android:parentActivityName=".MainActivity" />

        <!-- Rimettere a posto un file che l'app ha cambiato. -->
        <activity
            android:name=".ui.RestoreActivity"
            android:exported="false"
            android:label="Ripristino"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Le copie di sicurezza, e l'orario a cui farle da sole. -->
        <activity
            android:name=".ui.BackupActivity"
            android:exported="false"
            android:label="Backup"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- I comandi dello script di LinuxGSM. -->
        <activity
            android:name=".ui.CommandsActivity"
            android:exported="false"
            android:label="Comandi"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Le impostazioni del gioco: server.properties. -->
        <activity
            android:name=".ui.GameSettingsActivity"
            android:exported="false"
            android:label="Impostazioni del server"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tutti i parametri di LinuxGSM, modificabili. -->
        <activity
            android:name=".ui.ParamsActivity"
            android:exported="false"
            android:label="Impostazioni tecniche"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- File di comandi da lanciare in un tocco. -->
        <activity
            android:name=".ui.MacroActivity"
            android:exported="false"
            android:label="Macro"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- La configurazione del server in un file, per clonarlo altrove. -->
        <activity
            android:name=".ui.BlueprintActivity"
            android:exported="false"
            android:label="Progetto del server"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.WebMapActivity"
            android:exported="false"
            android:label="@string/web_map"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".notify.ServerWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".notify.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
